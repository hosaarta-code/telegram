name: Simple Approval System

on:
  workflow_dispatch:
    inputs:
      signal_id:
        description: 'Signal ID'
        required: true
        type: string
      symbol:
        description: 'Symbol (e.g., BTC/USDT)'
        required: true
        type: string
      action:
        description: 'Action (BUY/SELL)'
        required: true
        type: string
      entry_price:
        description: 'Entry Price'
        required: true
        type: string
      stop_loss:
        description: 'Stop Loss'
        required: true
        type: string
      take_profit:
        description: 'Take Profit'
        required: true
        type: string
      confidence:
        description: 'Confidence (%)'
        required: false
        type: string
        default: '70'
      analysis:
        description: 'Analysis text'
        required: false
        type: string
        default: 'No analysis provided'

permissions:
  contents: write

jobs:
  approval:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
      CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
    steps:
      - name: Send approval message
        id: send
        run: |
          MESSAGE=$(cat <<EOF
          📊 *TRADING SIGNAL - APPROVAL REQUIRED*

          Signal ID: ${{ github.event.inputs.signal_id }}
          Symbol: ${{ github.event.inputs.symbol }}
          Action: ${{ github.event.inputs.action }}
          Entry: $${{ github.event.inputs.entry_price }}
          SL: $${{ github.event.inputs.stop_loss }}
          TP: $${{ github.event.inputs.take_profit }}
          Confidence: ${{ github.event.inputs.confidence }}%

          📝 Analysis:
          ${{ github.event.inputs.analysis }}

          ⏰ *Expires in 5 minutes*

          ---
          *Please approve or reject this signal.*
          EOF
          )

          # Send message with inline keyboard
          RESPONSE=$(curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
            -d "chat_id=${CHAT_ID}" \
            -d "text=${MESSAGE}" \
            -d "parse_mode=Markdown" \
            -d "reply_markup={\"inline_keyboard\":[[{\"text\":\"✅ APPROVE\",\"callback_data\":\"approve_${{ github.event.inputs.signal_id }}\"},{\"text\":\"❌ REJECT\",\"callback_data\":\"reject_${{ github.event.inputs.signal_id }}\"}]]}")

          echo "RESPONSE=$RESPONSE" >> $GITHUB_ENV

      - name: Wait for approval
        id: wait
        run: |
          # This is a placeholder - the actual waiting logic will be handled by the bot
          echo "Waiting for approval..."
          sleep 300

      - name: Log result
        run: |
          echo "Signal ${{ github.event.inputs.signal_id }} processed."
